{
  "expo": {
    "name": "Recensement de Population",
    "slug": "census-mobile",
    "scheme": "census",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F9FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mg.recensement.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La localisation permet d’enregistrer les coordonnées des habitations.",
        "NSCameraUsageDescription": "La caméra permet de photographier les habitations et scanner les QR codes."
      }
    },
    "android": {
      "package": "mg.recensement.mobile",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Autoriser l’application à utiliser la caméra." }],
      ["expo-location", { "locationWhenInUsePermission": "Autoriser l’application à enregistrer la localisation des habitations." }],
      ["expo-image-picker", { "photosPermission": "Autoriser l’application à sélectionner des photos d’habitation." }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiUrl": "http://10.0.2.2:5001/api/v1"
    }
  }
}
