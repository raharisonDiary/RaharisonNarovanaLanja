POSTGRES_DB=census_db
POSTGRES_USER=census_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_PORT=5433

# Compatible Windows PowerShell 5.1 :
# $b = New-Object byte[] 64; $r = [Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); [Convert]::ToBase64String($b); $r.Dispose()
JWT_SIGNING_KEY_BASE64=replace_with_a_64_byte_base64_key

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password_of_at_least_12_characters

# Envoi automatique des identifiants et des OTP par WhatsApp Cloud API.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Modèle Meta approuvé recommandé pour les messages initiés par l’entreprise.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=fr

# SMTP utilisé pour les identifiants de compte et les OTP par e-mail.
PASSWORD_RECOVERY_EMAIL_ENABLED=false
PASSWORD_RECOVERY_EMAIL_HOST=smtp.example.com
PASSWORD_RECOVERY_EMAIL_PORT=587
PASSWORD_RECOVERY_EMAIL_ENABLE_SSL=true
PASSWORD_RECOVERY_EMAIL_USERNAME=
PASSWORD_RECOVERY_EMAIL_PASSWORD=
PASSWORD_RECOVERY_EMAIL_FROM_ADDRESS=no-reply@recensement.mg
PASSWORD_RECOVERY_EMAIL_FROM_NAME=Census Flow
