# Expo Web s'execute sur le meme ordinateur que l'API.
EXPO_PUBLIC_API_URL_WEB=http://localhost:5001/api/v1

# Expo Go / Android / iOS utilisent l'adresse reseau du PC.
# start-mobile.ps1 actualise automatiquement cette valeur.
EXPO_PUBLIC_API_URL_NATIVE=http://192.168.1.10:5001/api/v1

# Compatibilite avec les anciennes versions du projet.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5001/api/v1
