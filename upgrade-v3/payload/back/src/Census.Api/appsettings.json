{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BootstrapAdmin": {
    "FirstName": "Administrateur",
    "LastName": "Système"
  },
  "Jwt": {
    "Issuer": "Census.Api",
    "Audience": "Census.Clients",
    "AccessTokenLifetimeMinutes": 60
  },
  "Security": {
    "ApiRequestsPerMinute": 120,
    "LoginAttemptsPerMinute": 10,
    "MaximumRequestBodySizeBytes": 10485760
  },
  "AuthenticationSessions": {
    "RefreshTokenLifetimeDays": 30,
    "MaximumActiveSessionsPerUser": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:8081",
      "http://localhost:19006",
      "http://localhost:5174",
      "http://127.0.0.1:5174"
    ]
  },
  "PasswordRecovery": {
    "OtpLifetimeMinutes": 10,
    "ResetTokenLifetimeMinutes": 15,
    "MaximumVerificationAttempts": 5,
    "ExposeOtpInDevelopment": true
  },
  "PasswordRecoveryEmail": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@recensement.mg",
    "FromName": "Census Flow"
  },
  "WhatsApp": {
    "Enabled": false,
    "GraphApiVersion": "v24.0",
    "PhoneNumberId": "",
    "AccessToken": "",
    "TemplateName": "",
    "TemplateLanguage": "fr"
  }
}
